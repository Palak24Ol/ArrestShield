{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrestshield.local/schemas/conversation-1.0.0.json",
  "title": "ArrestShield Canonical Conversation",
  "type": "object",
  "required": [
    "schema_version", "conversation_id", "source", "language_profile",
    "conversation_label", "turns", "fingerprints", "quality"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "conversation_id": {"type": "string", "minLength": 8},
    "source": {
      "type": "object",
      "required": ["dataset_id", "revision", "license", "record_id", "source_type"],
      "properties": {
        "dataset_id": {"type": "string"},
        "revision": {"type": "string"},
        "license": {"type": "string"},
        "record_id": {"type": "string"},
        "original_split": {"type": ["string", "null"]},
        "source_type": {"type": "string"}
      }
    },
    "language_profile": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "conversation_label": {
      "type": "object",
      "required": ["is_scam", "scam_type", "provenance"],
      "properties": {
        "is_scam": {"type": ["integer", "null"], "enum": [0, 1, null]},
        "scam_type": {"type": ["string", "null"]},
        "provenance": {"type": "string"}
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["turn_id", "speaker_role", "raw_text", "normalized_text", "labels"],
        "properties": {
          "turn_id": {"type": "integer", "minimum": 0},
          "speaker_role": {"type": "string"},
          "raw_text": {"type": "string", "minLength": 1},
          "normalized_text": {"type": "string", "minLength": 1},
          "language": {"type": "string"},
          "labels": {
            "type": "object",
            "required": ["is_scam", "scam_type", "tactics", "stage", "provenance"],
            "properties": {
              "is_scam": {"type": ["integer", "null"], "enum": [0, 1, null]},
              "scam_type": {"type": ["string", "null"]},
              "tactics": {"type": "object"},
              "stage": {"type": ["string", "null"]},
              "provenance": {"type": "string"}
            }
          }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "required": ["exact_sha256", "template_sha256"],
      "properties": {
        "exact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "quality": {
      "type": "object",
      "required": ["training_eligible", "exclusion_reasons"],
      "properties": {
        "training_eligible": {"type": "boolean"},
        "exclusion_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
